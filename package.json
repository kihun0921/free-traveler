{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"tests/**/*.{ts,tsx}\" \"eslint.config.mjs\" \"next.config.ts\" \"postcss.config.mjs\" \"playwright.config.ts\" \"vitest.config.ts\" \"tsconfig.json\" \"package.json\" \".github/workflows/**/*.{yml,yaml}\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:public": "playwright test --project=chromium tests/e2e/public-smoke.spec.ts",
    "task:contract": "python scripts/audit_tasks.py",
    "screen:contract": "python scripts/check_screen_contract.py --mode=plan",
    "screen:contract:ci": "python scripts/check_screen_contract.py --mode=ci",
    "screen:contract:release": "python scripts/check_screen_contract.py --mode=release",
    "validate": "python scripts/validate_inputs.py && npm run task:contract && python scripts/build_waves.py && npm run screen:contract",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run task:contract && npm run screen:contract:ci && npm run build",
    "release:check": "npm run ci && npm run screen:contract:release && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.48.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-playwright": "^2.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
